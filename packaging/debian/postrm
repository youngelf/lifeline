#!/bin/sh
set -e

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        if [ -f /etc/apparmor.d/usr.sbin.dnsmasq ] && command -v apparmor_parser >/dev/null 2>&1; then
            if [ -d /sys/kernel/security/apparmor ]; then
                apparmor_parser -r -T -W /etc/apparmor.d/usr.sbin.dnsmasq || true
            fi
        fi
        ;;
    purge)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        rm -rf /run/lifeline
        rmdir --ignore-fail-on-non-empty /etc/lifeline/hosts.d /etc/lifeline 2>/dev/null || true
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
