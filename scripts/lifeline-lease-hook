# Wrapper invoked by dnsmasq --dhcp-script.
# Sets PYTHONPATH if lifeline was installed into /opt/lifeline/src.
if [ -d /opt/lifeline/src ]; then
    PYTHONPATH="/opt/lifeline/src${PYTHONPATH:+:$PYTHONPATH}"
    export PYTHONPATH
fi
exec /usr/bin/python3 -m lifeline.lease_hook "$@"
